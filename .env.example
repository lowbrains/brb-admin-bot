# ── Секреты ───────────────────────────────────────────────────────────────────
# Токен из BotFather. Формат: 123456789:AA...
TELEGRAM_BOT_TOKEN=
# API-ключ сервисного аккаунта Яндекс AI Studio.
MODEL_API_KEY=

# ── Группа ────────────────────────────────────────────────────────────────────
# Перекрывает runtime/config/connection.json. Отрицательное число.
BRB_CHAT_ID=
# Имя бота без @. Проверяется через getMe при запуске.
BRB_BOT_USERNAME=brb_team_admin_bot

# ── Маршрутизация ─────────────────────────────────────────────────────────────
# Пусто → Telegram напрямую. Заполнено → только Telegram идёт через этот прокси;
# вызов модели остаётся прямым в любом случае (tests/test_routing.py).
# Пример: http://tg-proxy:3128
TELEGRAM_PROXY=

# ── Пути ──────────────────────────────────────────────────────────────────────
# В контейнере задан в Dockerfile. Менять только при запуске без контейнера.
# BRB_RUNTIME_DIR=/runtime
