# ── Секреты ───────────────────────────────────────────────────────────────────
# Токен из BotFather. Формат: 123456789:AA...
TELEGRAM_BOT_TOKEN=
# Ключ провайдера модели. Для OpenAI — sk-...
MODEL_API_KEY=

# ── Группа ────────────────────────────────────────────────────────────────────
# Перекрывает runtime/config/connection.json. Отрицательное число.
BRB_CHAT_ID=
# Имя бота без @. Проверяется через getMe при запуске.
BRB_BOT_USERNAME=brb_team_admin_bot

# ── Маршрутизация ─────────────────────────────────────────────────────────────
# У каждого адресата свой маршрут: какой из них нужно заворачивать в туннель,
# зависит от того, где стоит сервер.
#   российский сервер  → доступен Яндекс, недоступны OpenAI и (возможно) Telegram
#   зарубежный сервер  → доступны OpenAI и Telegram, недоступен Яндекс
# Пусто → напрямую. Переменные независимы и друг на друга не влияют
# (проверяется tests/test_routing.py). Пример значения: http://tg-proxy:3128
TELEGRAM_PROXY=
MODEL_PROXY=

# ── Пути ──────────────────────────────────────────────────────────────────────
# В контейнере задан в Dockerfile. Менять только при запуске без контейнера.
# BRB_RUNTIME_DIR=/runtime
